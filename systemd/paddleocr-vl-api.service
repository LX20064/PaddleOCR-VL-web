# ============================================================
# PaddleOCR-VL API 服务（paddlex serve）
# 用法：
#   1. 将文件中所有 YOUR_USER 替换为你的用户名
#   2. sudo cp paddleocr-vl-api.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now paddleocr-vl-api
# ============================================================
[Unit]
Description=PaddleOCR-VL API Service (paddlex serve, port 8080)
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/paddleocr-vl-web
ExecStart=/home/YOUR_USER/.venv_paddleocr/bin/paddlex --serve \
    --pipeline /home/YOUR_USER/paddleocr-vl-web/PaddleOCR-VL.yaml \
    --device gpu:0 --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=10
# 首次启动需加载模型，允许较长的启动时间
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
