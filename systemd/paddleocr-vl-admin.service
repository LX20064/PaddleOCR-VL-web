# ============================================================
# PaddleOCR-VL 管理后台（admin.py, Gradio, port 7861）
# 用法：
#   1. 将文件中所有 lx 替换为你的用户名
#   2. sudo cp paddleocr-vl-admin.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now paddleocr-vl-admin
# ============================================================
[Unit]
Description=PaddleOCR-VL Admin Panel (Gradio, port 7861)
After=network.target paddleocr-vl-api.service

[Service]
Type=simple
User=lx
WorkingDirectory=/home/lx/paddleocr-vl-web
Environment=ADMIN_SERVER_NAME=0.0.0.0
Environment=ADMIN_SERVER_PORT=7861
ExecStart=/home/lx/.venv_paddleocr/bin/python /home/lx/paddleocr-vl-web/admin.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
