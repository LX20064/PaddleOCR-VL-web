# ============================================================
# Docker 构建忽略清单
# 镜像内只保留源码与运行期自动生成的东西：
#   - llama.cpp 由 builder 阶段按多架构重新编译（不进镜像源码/旧产物）
#   - 官方模型 / GGUF 由 model_manager 在容器运行时下载或挂载持久化
# ============================================================

# 版本控制
.git
.gitignore

# 大体积运行期产物（镜像内由 builder 编译 / 运行时下载）
tools/
outputs/
logs/

# 进程 pid 文件
*.pid

# Python 缓存与虚拟环境
__pycache__/
*.pyc
.venv
.venv_*
venv

# 运行期自动生成的扫描图标（web_ocr.py 会自行重建）
.scan_icons/

# 测试图片（非运行时依赖）
test_table.png
test_scan.png

# 备份与宿主机部署文件
*.bak*
systemd/

# 其它临时文件
*.log
.DS_Store
